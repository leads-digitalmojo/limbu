{
  "expo": {
    "name": "Limbu AI",
    "slug": "limbu-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "limbu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "ai.limbu.app" },
    "android": {
      "package": "ai.limbu.app",
      "adaptiveIcon": {
        "backgroundColor": "#FACC15",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro", "output": "server" }
  }
}
