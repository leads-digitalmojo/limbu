# Google OAuth — Business Profile API
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/gmb/oauth/callback

# Signs the session cookie set after a successful Google connect.
# Any long random string; generate one with: openssl rand -base64 32
SESSION_SECRET=

# Google Ads API — powers the Keyword Planner. One agency-level credential
# set, not a per-user connection like GMB above.
#
# 1. In the same Google Cloud project as GOOGLE_CLIENT_ID, enable the
#    "Google Ads API".
# 2. Apply for a developer token at ads.google.com under your manager
#    account: Tools & Settings > Setup > API Center. Test-account tokens
#    work immediately; production access needs Google's approval.
# 3. Generate a refresh token once via the OAuth 2.0 Playground
#    (https://developers.google.com/oauthplayground):
#      - gear icon -> "Use your own OAuth credentials" -> paste
#        GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from above
#      - in Step 1, enter scope https://www.googleapis.com/auth/adwords,
#        authorize with the Google account that has access to the manager
#        account
#      - in Step 2, "Exchange authorization code for tokens" — copy the
#        refresh_token into GOOGLE_REFRESH_TOKEN below
#    This step also needs the Playground's own redirect URI
#    (https://developers.google.com/oauthplayground) added to the OAuth
#    client's authorized redirect URIs in Cloud Console — temporarily, just
#    for this one-time exchange.
# 4. GOOGLE_MCC_ID is your manager account's ID ("MCC" is Google's older name
#    for it); GOOGLE_CUSTOMER_ID is the account queried for keyword ideas,
#    often the same one. Both are the 10-digit numbers shown in the Google
#    Ads UI (strip the dashes, e.g. "123-456-7890" -> "1234567890").
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_MCC_ID=
GOOGLE_CUSTOMER_ID=
